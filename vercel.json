{
  "framework": "nextjs",
  "buildCommand": "npx next build",
  "installCommand": "npm install --legacy-peer-deps",
  "git": {
    "deploymentEnabled": true
  },
  "caching": {
    "runtimeCaching": []
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}